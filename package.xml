<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wuji_description</name>
  <version>0.1.0</version>
  <description>
    WUJI robot description package containing URDF, MJCF, MJX, and USD models.
    Includes mesh files and configuration for simulation environments.
  </description>

  <maintainer email="dev@wuji.tech">WUJI Technology</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/wuji-technology/wuji-description</url>
  <url type="repository">https://github.com/wuji-technology/wuji-description</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
