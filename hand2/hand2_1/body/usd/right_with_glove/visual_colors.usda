#usda 1.0

def "wujihand2_1_right_cover"
{
    def "Looks"
    {
        def Material "VisualBlackShell"
        {
            token outputs:mdl:surface.connect = </wujihand2_1_right_cover/Looks/VisualBlackShell/OmniPBR.outputs:out>
            token outputs:surface.connect = </wujihand2_1_right_cover/Looks/VisualBlackShell/PreviewSurface.outputs:surface>

            def Shader "OmniPBR"
            {
                uniform token info:id = "OmniPBR"
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.02, 0.02, 0.02)
                float inputs:metallic_constant = 0
                float inputs:reflection_roughness_constant = 0.45
                token outputs:out
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                float inputs:metallic = 0
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    over "r_index_finger_proximal"
    {
        over "visuals"
        {
            over "r_index_finger_proximal"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </wujihand2_1_right_cover/Looks/VisualBlackShell>
                }
            }
        }
    }

    over "r_index_finger_proximal_abd"
    {
        over "visuals"
        {
            over "r_index_finger_proximal_abd"
            {
                over "mesh" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </wujihand2_1_right_cover/Looks/VisualBlackShell>
                }
            }
        }
    }

